# Whispering Woods / Smartino Backend Configuration
# Copy this file to .env and update with your settings

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
ADMIN_API_KEY=your-admin-api-key-here
SECRET_KEY=your-secret-key-change-in-production

# DRY_RUN Mode (Safe Day-1 Operation)
DRY_RUN=false

# Model Paths
WHISPER_MODEL_PATH=E:\Projects\Models\Whisper\whisper-small-egyptian-arabic
TTS_MODEL_PATH=
CV_MODEL_PATH=

# ============================================
# QWEN LLM CONFIGURATION (NEW)
# ============================================

# Qwen Model Path
QWEN_MODEL_PATH=E:\Projects\Models\LLMs\Qwen\Qwen3-4B

# Toggle between Legacy NLU and Qwen LLM
# false = Use Legacy NLU (Rule-Based, Fast, Predictable)
# true  = Use Qwen LLM (Generative, Creative, Natural)
USE_LLM_GENERATOR=false

# LLM Generation Parameters
LLM_TEMPERATURE=0.8    # High creativity (0.0-1.0)
LLM_MAX_TOKENS=150     # Maximum response length

# ============================================

# Audio Settings
AUDIO_SAMPLE_RATE=22050
AUDIO_CHANNELS=1
MAX_AUDIO_SIZE_MB=16

# Logging
LOG_LEVEL=INFO
LOG_DIR=
ACTIONS_LOG_FILE=

# Database (Optional)
DATABASE_URL=

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
